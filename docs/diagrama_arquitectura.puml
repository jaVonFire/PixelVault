@startuml
' ============================================================
' PIXELVAULT - Diagrama de Arquitectura
' Version ordenada: flujo vertical, pocas lineas
' ============================================================

skinparam componentStyle rectangle
skinparam defaultFontSize 13
skinparam ArrowColor #999999

title <size:20><b>Arquitectura de PixelVault</size>\n<size:11>Tienda online de gaming (HTML + PHP + MySQL)</size></b>

' ===================== 1. USUARIO =====================
package "1. USUARIO  -  navegador" {
  frame "Paginas (HTML)" {
    [index.html]
    [account.html]
    [products.html]
    [admin.html]
    [profile.html]
  }
  frame "Cliente (JS)" {
    [api.js  (conexion a la API)]
  }
}

' ===================== 2. SERVIDOR =====================
package "2. SERVIDOR  -  Apache + PHP" {
  frame "API REST (punto de entrada)" {
    [api/index.php  (router)] as router
  }
  frame "Controladores" {
    [auth.php\nlogin/registro/perfil] as cauth
    [productos.php\nCRUD de productos] as cprod
    [carrito.php] as ccart
    [pedidos.php] as cped
    [categorias.php] as ccat
    [admin.php\ndashboard/clientes] as cadmin
  }
  frame "Conexion a datos" {
    [config/db.php  (PDO)] as cdb
  }
}

' ===================== 3. DATOS =====================
node "3. BASE DE DATOS  -  MySQL" {
  database "pixelvault\n(usuario, producto, categoria,\npedido, detalle_pedido, carrito)" as bd
}

' ===================== FLUJO PRINCIPAL =====================
' 3 flechas grandes, de arriba hacia abajo
api.js -down-> router : "Peticiones HTTP\n(JSON + sesion)"
router -down-> cdb : "usa"
cdb -down-> bd : "Consultas SQL (PDO)"

' Detalle interno (sin cruzarse): el router envia a cada controlador
router --> cauth
router --> cprod
router --> ccart
router --> cped
router --> ccat
router --> cadmin

@enduml
