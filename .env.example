# Copia este archivo como .env y completa solo las variables que necesites.
# No subas el archivo .env real al repositorio.

PV_DB_HOST=127.0.0.1
PV_DB_NAME=pixelvault
PV_DB_USER=root
PV_DB_PASSWORD=

# Para respuestas abiertas del chatbot, configura una clave de Gemini AI Studio.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT=25
GEMINI_RETRIES=3
GEMINI_RETRY_DELAY_MS=2000

# PV_ADMIN_EMAIL vacío usa el correo de la primera cuenta admin; puedes fijar otro destinatario.
PV_MAIL_ENABLED=1
PV_MAIL_FROM=javierandresn12@gmail.com
PV_MAIL_FROM_NAME=PIXELVAULT
PV_ADMIN_EMAIL=
PV_LOW_STOCK_THRESHOLD=4
PV_SMTP_HOST=smtp.gmail.com
PV_SMTP_PORT=465
PV_SMTP_SECURITY=ssl
PV_SMTP_USERNAME=javierandresn12@gmail.com
PV_SMTP_PASSWORD=
PV_APP_URL=http://localhost/pixelV
PV_MAIL_MAX_ATTEMPTS=5
PV_AUTOMATION_TICK_SECONDS=5
PV_AUTOMATION_RETENTION_DAYS=90
